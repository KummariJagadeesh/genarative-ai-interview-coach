rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile and sub-collections
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email != null);
      
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email != null);
      }
    }
  }
}
